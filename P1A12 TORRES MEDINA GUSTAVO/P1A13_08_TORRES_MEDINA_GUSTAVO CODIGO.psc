// Calcular la suma de los cincuenta primeros números enteros.
Algoritmo P1A13_08_TORRES_MEDINA_GUSTAVO
	Definir x Como Entero
	Definir s Como Entero
	x <- 1
	s <- 0
	Mientras x<=50 Hacer
		s <- s+x
		x <- x+1
	FinMientras
	Escribir 'La suma de los 50 primeros números enteros es: ', s
FinAlgoritmo
