// Suma de los números pares comprendidos entre 2 y 100
Algoritmo P1A12_04_Torres_Medina_Gustavo
	Definir suma, num Como Real
	suma <- 2
	num <- 4
	// Ciclo
	Repetir
		suma <- suma+num
		num <- num+2
	Hasta Que num>100
	Escribir 'La suma de los núm pares comprendidos entre 2 y 100 es: ', suma
FinAlgoritmo
