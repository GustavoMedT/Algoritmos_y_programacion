//Escribir un algoritmo que acepte tres números enteros e imprima el mayor de ellos.
Algoritmo P1A13_019_TORRES_MEDINA_GUSTAVO
	Definir a,b,c Como entero
	Escribir "Ingrese 3 numeros enteros"
	Leer a,b,c
	Si a<b Entonces
		si a<c
			escribir "El valor mayor es:",c
		FinSi
		si b<c
			escribir "El valor mayor es: ",c
		SiNo
			escribir "El valor mayor es: ",b
		FinSi
	SiNo
		Escribir "El valor mayor es: ",a
	FinSi
FinAlgoritmo
